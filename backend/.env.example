DATABASE_URL=postgres://facilix_user:facilix_password@localhost:5432/facilix
JWT_SECRET=replace-with-a-long-random-string
PORT=4000

# Document attachments (object storage). Leave unset (or set STORAGE_DRIVER=fs)
# for zero-config local disk under backend/uploads. For MinIO / AWS S3 / R2:
#STORAGE_DRIVER=s3
#S3_ENDPOINT=http://127.0.0.1:9000     # MinIO (docker-compose also accepts MINIO_ENDPOINT=host:port)
#S3_ACCESS_KEY=minioadmin
#S3_SECRET_KEY=minioadmin
#S3_BUCKET=facilix
