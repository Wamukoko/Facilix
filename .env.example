# Docker Compose environment — copy to .env and override the secrets.
# Compose reads this automatically from a .env file next to docker-compose.yml.
# Backend local dev uses backend/.env instead (DATABASE_URL/JWT_SECRET/PORT).

POSTGRES_USER=facilix_user
POSTGRES_PASSWORD=facilix_password
POSTGRES_DB=facilix
POSTGRES_PORT=5432

API_PORT=4000
JWT_SECRET=replace-with-a-long-random-string

MINIO_ROOT_USER=facilix_minio
MINIO_ROOT_PASSWORD=facilix_minio_secret
